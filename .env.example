# App-Thru Environment Configuration
# Copy this to .env and fill in your values.

# Server
PORT=3001
NODE_ENV=production

# Authentication (change this in production!)
JWT_SECRET=your-secret-key-here-change-me

# Twilio SMS (optional — falls back to console logging in dev)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Stripe Payments (optional — falls back to simulated payments in dev)
STRIPE_SECRET_KEY=

# ElevenLabs natural voice (optional — kiosk falls back to browser voice)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
